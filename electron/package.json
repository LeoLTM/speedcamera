{
    "name": "speedcamera-electron",
    "productName": "speedcamera-electron",
    "version": "1.0.0",
    "description": "Speedcamera companion app to control the ESP8266",
    "main": ".vite/build/main.js",
    "scripts": {
        "start": "electron-forge start",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "publish": "electron-forge publish",
        "prett": "prettier . --write",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:unit": "jest",
        "test:e2e": "playwright test",
        "test:all": "jest && playwright test",
        "db:generate": "ts-node src/scripts/generate-sample-data.ts",
        "db:fill": "echo '⚠️  Use the app interface to import data. Run \"npm run db:generate\" first, then use the Import button in the Violations page.'",
        "db:clear": "echo '⚠️  Use the app interface to clear data. Use the Clear button in the Violations page.'"
    },
    "devDependencies": {
        "@electron-forge/cli": "^7.5.0",
        "@electron-forge/maker-deb": "^7.5.0",
        "@electron-forge/maker-rpm": "^7.5.0",
        "@electron-forge/maker-squirrel": "^7.5.0",
        "@electron-forge/maker-zip": "^7.5.0",
        "@electron-forge/plugin-auto-unpack-natives": "^7.5.0",
        "@electron-forge/plugin-fuses": "^7.5.0",
        "@electron-forge/plugin-vite": "^7.5.0",
        "@electron-forge/shared-types": "^7.4.0",
        "@electron/fuses": "^1.8.0",
        "@playwright/test": "^1.48.0",
        "@storybook/addon-essentials": "^8.3.5",
        "@storybook/addon-interactions": "^8.3.5",
        "@storybook/addon-links": "^8.3.5",
        "@storybook/addon-onboarding": "^8.3.5",
        "@storybook/blocks": "^8.3.5",
        "@storybook/react": "^8.3.5",
        "@storybook/react-vite": "^8.3.5",
        "@storybook/test": "^8.4.1",
        "@swc/cli": "^0.4.0",
        "@swc/core": "^1.9.2",
        "@swc/jest": "^0.2.36",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.0.1",
        "@testing-library/user-event": "^14.5.2",
        "@types/electron-squirrel-startup": "^1.0.2",
        "@types/jest": "^29.5.13",
        "@types/node": "^22.7.5",
        "@types/react": "^18.3.11",
        "@types/react-dom": "^18.3.1",
        "autoprefixer": "^10.4.20",
        "electron": "^33.2.0",
        "electron-playwright-helpers": "^1.7.1",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "postcss": "^8.4.47",
        "prettier": "^3.3.3",
