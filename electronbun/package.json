{
	"name": "speedcamera-electronbun",
	"version": "1.0.0",
	"description": "A remake of the Speedcamera companion app using Electrobun",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build:canary": "vite build && electrobun build --env=canary"
	},
	"dependencies": {
		"@fontsource-variable/figtree": "^5.2.10",
		"@hugeicons/core-free-icons": "^4.1.1",
		"@hugeicons/react": "^1.1.6",
		"@tailwindcss/postcss": "^4.2.4",
		"@tailwindcss/vite": "^4.2.4",
		"@tanstack/react-router": "^1.168.23",
		"@types/serialport": "^10.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electrobun": "1.16.0",
		"lucide-react": "^1.8.0",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.4.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"serialport": "^13.0.0",
		"shadcn": "^4.4.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.3.6",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "^25.6.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^4.2.4",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	}
}
