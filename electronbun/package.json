{
	"name": "speedcamera-electronbun",
	"version": "1.0.0",
	"description": "A remake of the Speedcamera companion app using Electrobun",
	"scripts": {
		"start": "vite build &&  electrobun dev",
		"start:mock": "MOCK_MODE=true vite build && MOCK_MODE=true electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"dev:hmr:mock": "concurrently \"bun run hmr\" \"MOCK_MODE=true electrobun dev\"",
		"hmr": "vite --port 5173",
		"build:canary": "vite build && electrobun build --env=canary",
		"build:stable": "vite build && electrobun build --env=stable",
		"lint": "eslint src",
		"lint:ci": "eslint src --max-warnings 0",
		"setup:esptool": "mkdir -p resources && curl -fsSL https://github.com/espressif/esptool/releases/download/v5.2.0/esptool-v5.2.0-linux-amd64.tar.gz | tar -xz --wildcards '*/esptool' --strip-components=1 && mv esptool resources/esptool && chmod +x resources/esptool",
		"db:reset": "bun scripts/reset-db.ts dev",
		"db:reset:stable": "bun scripts/reset-db.ts stable",
		"db:reset:all": "bun scripts/reset-db.ts all"
	},
	"dependencies": {
		"@asl-gokart/bun-aravis": "^0.1.0",
		"@fontsource-variable/figtree": "^5.2.10",
		"@hugeicons/core-free-icons": "^4.1.1",
		"@hugeicons/react": "^1.1.6",
		"@tailwindcss/postcss": "^4.2.4",
		"@tailwindcss/vite": "^4.2.4",
		"@tanstack/react-router": "^1.168.23",
		"bun-serialport": "^0.1.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electrobun": "1.18.1",
		"lucide-react": "^1.8.0",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.4.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-webcam": "^7.2.0",
		"shadcn": "^4.7.0",
		"sharp": "^0.35.2",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.3.6",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@eslint/js": "^9.27.0",
		"@types/bun": "latest",
		"@types/node": "^25.6.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/react-webcam": "^3.0.0",
		"@types/three": "^0.184.0",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"eslint": "^9.27.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"globals": "^16.1.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^4.2.4",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.32.1",
		"vite": "^6.0.3"
	}
}
