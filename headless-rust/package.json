{
  "name": "speedcamera-rust-ui",
  "type": "module",
  "version": "0.5.0",
  "description": "Speedcamera Web UI for Raspberry Pi and remote browser control",
  "scripts": {
    "dev": "vite",
    "dev:server": "cargo run -- --mock",
    "dev:all": "concurrently \"bun run dev\" \"cargo run -- --mock\"",
    "build": "vite build",
    "build:all": "vite build && cargo build --release",
    "serve": "cargo run --release",
    "install:pi": "./scripts/install-remote.sh",
    "deploy:pi": "./scripts/deploy-to-pi.sh",
    "cleanup:pi": "./scripts/cleanup-remote.sh",
    "test:server": "bun ./scripts/test-server.ts",
    "setup:esptool": "mkdir -p resources && curl -fsSL https://github.com/espressif/esptool/releases/download/v5.2.0/esptool-v5.2.0-linux-amd64.tar.gz | tar -xz --wildcards '*/esptool' --strip-components=1 && mv esptool resources/esptool && chmod +x resources/esptool"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.10",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-router": "^1.168.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-webcam": "^7.2.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-webcam": "^3.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
