{
  "name": "speedcamera-headless",
  "type": "module",
  "version": "0.4.0",
  "description": "Headless Speedcamera daemon and Web UI for Raspberry Pi 4/5 and remote browser control",
  "scripts": {
    "dev": "concurrently \"bun run dev:client\" \"bun run dev:server\"",
    "dev:mock": "concurrently \"bun run dev:client\" \"MOCK_MODE=true bun --watch src/server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "bun --watch src/server/index.ts",
    "build": "vite build",
    "start": "vite build && bun src/server/index.ts",
    "start:mock": "MOCK_MODE=true vite build && MOCK_MODE=true bun src/server/index.ts",
    "serve": "bun src/server/index.ts",
    "serve:mock": "MOCK_MODE=true bun src/server/index.ts",
    "install:pi": "./scripts/install-remote.sh",
    "deploy:pi": "./scripts/deploy-to-pi.sh",
    "cleanup:pi": "./scripts/cleanup-remote.sh",
    "setup:esptool": "mkdir -p resources && curl -fsSL https://github.com/espressif/esptool/releases/download/v5.2.0/esptool-v5.2.0-linux-amd64.tar.gz | tar -xz --wildcards '*/esptool' --strip-components=1 && mv esptool resources/esptool && chmod +x resources/esptool"
  },
  "dependencies": {
    "@asl-gokart/bun-aravis": "^0.2.0",
    "@fontsource-variable/figtree": "^5.2.10",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@napi-rs/canvas": "^1.0.3",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-router": "^1.168.23",
    "bun-serialport": "^0.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-webcam": "^7.2.0",
    "shadcn": "^4.7.0",
    "sharp": "^0.35.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-webcam": "^3.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
